parameters:
	level: max
	phpVersion: 80400
	paths:
		- src/
		- tests/
		- fuzz/target_decoder.php
	bootstrapFiles:
		- vendor-bin/fuzzer/vendor/autoload.php
		- vendor-bin/phpunit/vendor/autoload.php
		- vendor/symplify/easy-coding-standard/vendor/autoload.php
includes:
	- vendor/phpstan/phpstan/conf/bleedingEdge.neon
